 null}, {"id": "readme_not_detected", "label": "Graceful Not-Detected Degradation", "file_type": "rationale", "source_file": "README.md", "source_location": "Requirements", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If a tool isn't installed or has no data, its panel shows a friendly 'not detected' state while the other panel renders normally \u2014 no demo or placeholder numbers are ever shown, because fabricated data would undermine the dashboard's credibility."}, {"id": "readme_file_protocol", "label": "No-Server file:// Design", "file_type": "rationale", "source_file": "README.md", "source_location": "FAQ", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data is a local script, not a fetch(), so the page opens straight from disk: no server, no build step, no npm install, no account, no telemetry."}, {"id": "readme_chartjs", "label": "Vendored Chart.js", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vendored in vendor/chart.umd.min.js so the project needs zero npm install."}, {"id": "readme_dollars_per_million", "label": "dollarsPerMillionTokens Rate", "file_type": "concept", "source_file": "README.md", "source_location": "Configure", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single blended $/million-tokens rate (default 30) so the page can talk in dollars: one rate, one rule, applied identically to both tools; change it in config.json and every dollar figure moves with it."}], "edges": [{"source": "readme_token_savings_dashboard", "target": "docs_how_it_works_methodology", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "More", "weight": 1.0}, {"source": "readme_token_savings_dashboard", "target": "docs_install_guide", "rel