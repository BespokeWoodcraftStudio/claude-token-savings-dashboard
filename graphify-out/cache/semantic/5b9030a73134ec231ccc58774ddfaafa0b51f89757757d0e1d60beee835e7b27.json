: "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HOW-IT-WORKS.md", "source_location": "The formulas, exactly", "weight": 1.0}], "hyperedges": [{"id": "savings_data_flow_pipeline", "label": "Savings Data Flow Pipeline", "nodes": ["readme_claude_mem", "readme_graphify", "readme_collector", "readme_savings_data", "index_dashboard_ui"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HOW-IT-WORKS.md"}, {"id": "honesty_guardrails", "label": "Honesty Guardrails", "nodes": ["contributing_honesty_principle", "docs_how_it_works_baseline", "docs_how_it_works_efficiency_cap", "docs_how_it_works_illustrative_projection"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HOW-IT-WORKS.md"}]}